{
  "name": "code-motion-film",
  "version": "1.0.0",
  "private": true,
  "description": "Code-made film (Remotion) — started from the jin-code-motion starter",
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "lint": "eslint src && tsc",
    "fonts": "NODE_USE_ENV_PROXY=1 node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-fonts.ts",
    "audio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-audio.ts",
    "stills": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-stills.ts",
    "render:cloud": "remotion render src/index.ts --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render": "npm run render:cloud -- Film out/film.mp4",
    "check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-av.ts out/film.mp4 check.json"
  }
}
